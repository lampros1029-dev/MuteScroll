# Copy to .env (never commit .env). In production, use Railway / Cloudflare secrets.

# --- API / MCP ---
PORT=8080
PUBLIC_BASE_URL=https://api.mutescroll.app

# --- Data ---
DATABASE_URL=
REDIS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mutescroll-media

# --- ASR providers (M1) ---
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# --- Retrieval (M4) ---
# Residential/ISP egress proxy for media workers. Never put user cookies here.
MEDIA_EGRESS_PROXY_URL=
COBALT_API_URL=

# --- Billing (M3) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- Limits (server-side, configurable; PRD §22) ---
MAX_VIDEO_SECONDS_FREE=600
MAX_DOWNLOAD_BYTES=2147483648
ANON_CREDITS=5
FREE_CREDITS_PER_MONTH=20
