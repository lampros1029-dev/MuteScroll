# Copy to .env (never commit .env). In production, use Railway / Cloudflare secrets.

# --- API / MCP ---
PORT=8080
PUBLIC_BASE_URL=https://api.mutescroll.xyz

# --- Data ---
# Postgres connection string (postgres://user:pass@host:5432/db). Unset = in-memory stores for one process.
# Apply the schema before the first start: npm run build && npm run migrate -w @mutescroll/api-mcp
DATABASE_URL=

# --- Speech-to-text ---
# Read by the media worker.
GROQ_API_KEY=

# --- Retrieval ---
# Optional residential/ISP egress proxy. Read by the media worker. Never put user cookies here.
MEDIA_EGRESS_PROXY_URL=

# --- Billing (M3, Paddle is the merchant of record) ---
# Sandbox API key (the value contains sdbx). The API host is sandbox-api.paddle.com only when the key contains sdbx.
# A key without sdbx calls api.paddle.com. Railway production already uses the live key.
PADDLE_API_KEY=
# Notification destination secret for the key above. Destination URL: https://api.mutescroll.xyz/v1/paddle/webhook
PADDLE_WEBHOOK_SECRET=
# Comma-separated plan=price_id from the Paddle catalog. founding is the $79/yr Pro pass.
# Placeholders only, not real ids: creator=pri_xxx,pro=pri_xxx,team=pri_xxx,founding=pri_xxx
# Optional interval keys: creator_month, creator_year, pro_month, pro_year, team_month, team_year.
# Add-ons, same list: pack_500, pack_2000, seat. A pack adds credits. seat adds one Team seat. Neither replaces the plan.
# Railway already points this at the live price ids. Do not hard-code pri_ values in source.
PADDLE_PRICE_IDS=
# Checkout page token. A test_ prefix selects Paddle sandbox. A live_ prefix must not call Environment.set("sandbox").
# The public site already uses the live client token on Railway.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Live credentials. Names only. Live values are already on Railway and in gitignored .secrets. Never commit them.
# Live API key: Paddle dashboard > Developer tools > Authentication (Paddle's go-live checklist also lists My account > Settings > Authentication). Never invent this value.
PADDLE_LIVE_API_KEY=
# Live client-side token (prefix live_). Same Authentication screen, client-side token. The public checkout already reads the live token from NEXT_PUBLIC_PADDLE_CLIENT_TOKEN.
PADDLE_LIVE_CLIENT_TOKEN=
# Secret for a live notification destination at https://api.mutescroll.xyz/v1/paddle/webhook. Reuse the destination if it already exists; creating another rotates the secret.
PADDLE_LIVE_WEBHOOK_SECRET=

# --- Limits (server-side, configurable; PRD §22) ---
MAX_DOWNLOAD_BYTES=2147483648
# Credits an anonymous client may spend per window (1 credit per started 10 min). PRD D5.
ANON_CREDITS=5
# Length of the anonymous credit window in seconds (default one day).
ANON_QUOTA_WINDOW_SECONDS=86400
# Transcribe calls per client per minute (sliding window).
ANON_REQUESTS_PER_MINUTE=10
# Account plans (monthly credits, longest video) are a table in apps/api-mcp/src/billing/plans.ts (PRD 20.2).
# Largest accepted upload in bytes (PRD 14: 2 GB).
MAX_UPLOAD_BYTES=2147483648

# --- MCP server (M2, apps/api-mcp) ---
# Quota key: the socket address, unless TRUST_PROXY=true. Only enable behind a proxy you control.
TRUST_PROXY=false
# Header read when TRUST_PROXY=true. The right-most entry is used (the one our proxy appends).
CLIENT_IP_HEADER=x-forwarded-for
# Largest JSON-RPC request body accepted on /mcp, in bytes.
MCP_MAX_BODY_BYTES=262144
# How long transcribe_video waits for a result before returning status "processing".
TOOL_WAIT_MS=25000
# Worker processes running at once.
JOB_CONCURRENCY=2
# Retention for finished jobs (succeeded / failed). PRD 12: anonymous users keep results 24 h.
JOB_TTL_SECONDS=86400
JOB_FAILED_TTL_SECONDS=3600
# One-time upload links expire after this many seconds.
UPLOAD_TOKEN_TTL_SECONDS=3600
# Longest media a single job may process, in seconds.
MEDIA_MAX_SECONDS=7200
# Plan page linked from quota and length messages (informational only, PRD 4.1).
PLANS_URL=https://mutescroll.xyz/plans
# Media worker bridge: interpreter with mutescroll_media installed, its working directory, and a per-job timeout.
MEDIA_WORKER_PYTHON=python
MEDIA_WORKER_DIR=
MEDIA_WORKER_TIMEOUT_SECONDS=900

# --- REST API and accounts (M3, apps/api-mcp) ---
# Largest JSON body the /v1 API reads, in bytes.
REST_JSON_MAX_BODY_BYTES=16384
# Transcribe calls per signed-in account per minute (anonymous callers keep ANON_REQUESTS_PER_MINUTE).
ACCOUNT_REQUESTS_PER_MINUTE=30
# Sign-ups per client IP per hour and log-in attempts per client IP per minute. Email verification and
# password reset exist. Those routes answer 503 email_not_configured when the mailer variables are missing.
AUTH_SIGNUPS_PER_IP_PER_HOUR=5
AUTH_LOGINS_PER_IP_PER_MINUTE=10
# Web session lifetime in days. It slides forward on use (PRD 17).
SESSION_TTL_DAYS=30
# Google sign-in for /signup and /login. Web application client, scopes openid email profile.
# Redirect URI: https://mutescroll.xyz/api/v1/auth/google/callback
# Local redirect URI: http://localhost:3000/api/v1/auth/google/callback
# Leave empty until a client exists. Do not copy GMAIL_OAUTH_CLIENT_ID or GMAIL_OAUTH_CLIENT_SECRET:
# that client is gmail.send only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Retention for succeeded jobs owned by an account, i.e. the library, in days (PRD 12).
ACCOUNT_JOB_TTL_DAYS=7

# A public video link uses the video's own captions when yt-dlp already returns them, then
# yt-dlp audio and Groq. Upload is the fallback when that fetch fails.
# A Groq transcript is speech recognition, not the video's own captions.

# OpenAI domain ownership token, served as text at /.well-known/openai-apps-challenge.
# Unset leaves that path as 404. The value is public once served. Never log it.
OPENAI_APPS_CHALLENGE=

# --- Errors (optional) ---
# When set, the API reports error class names only to Sentry. Unset = no report and no outbound call.
SENTRY_DSN=
